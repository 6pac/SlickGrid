{
  "name": "slickgrid-docs-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "VitePress site and API extraction pipeline for 6pac/SlickGrid",
  "scripts": {
    "api": "node tools/extract-api.mjs",
    "drift": "node tools/check-drift.mjs",
    "links": "node tools/check-links.mjs",
    "predocs:build": "npm run api",
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview ."
  },
  "devDependencies": {
    "ts-morph": "^28.0.0",
    "vitepress": "^2.0.0-alpha.21"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
